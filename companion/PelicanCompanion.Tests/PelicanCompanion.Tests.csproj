<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SmapiDir Condition="'$(SmapiDir)' == ''">/Applications/Stardew Valley.app/Contents/MacOS</SmapiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PelicanCompanion/PelicanCompanion.csproj" />
    <!-- the mod project doesn't copy it; the tests need it at run time. SMAPI itself is
         x64-only and stays out: the tested code must not touch its types -->
    <Reference Include="Newtonsoft.Json" HintPath="$(SmapiDir)/smapi-internal/Newtonsoft.Json.dll" Private="true" />
  </ItemGroup>
</Project>
